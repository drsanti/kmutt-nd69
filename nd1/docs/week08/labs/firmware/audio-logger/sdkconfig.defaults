# Week 08 audio-logger (ESP-IDF v6.1, ES3C28P / ESP32-S3R8)
CONFIG_IDF_TARGET="esp32s3"
# The board's USB-C goes to the native USB Serial/JTAG peripheral (Week 02, Lesson 06).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Keep log output quiet so text does not mix with the binary audio frames.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
