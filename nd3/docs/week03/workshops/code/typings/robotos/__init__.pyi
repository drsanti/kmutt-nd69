from typing import Any

class Node:
    def __init__(self, name: str, *args: Any, **kwargs: Any) -> None: ...
    def __enter__(self) -> Node: ...
    def __exit__(self, *args: Any) -> None: ...
    def create_publisher(self, topic: str, msg_type: Any, *args: Any, **kwargs: Any) -> Any: ...
    def create_subscriber(self, topic: str, msg_type: Any, *args: Any, **kwargs: Any) -> Any: ...
    def create_service(self, *args: Any, **kwargs: Any) -> Any: ...
    def call(self, *args: Any, **kwargs: Any) -> Any: ...
    def create_action(self, *args: Any, **kwargs: Any) -> Any: ...
    def action_client(self, *args: Any, **kwargs: Any) -> Any: ...
    def declare_parameter(self, *args: Any, **kwargs: Any) -> Any: ...
    def param_get(self, *args: Any, **kwargs: Any) -> Any: ...
    def set_allow_remote_params(self, *args: Any, **kwargs: Any) -> Any: ...
    @staticmethod
    def version() -> str: ...

class RobotosError(Exception):
    status: int
